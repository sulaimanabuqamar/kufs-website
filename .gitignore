# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template must be committed: it is the documentation for what a
# deploy needs, and it contains no values.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.screenshots/
public/hero/frames.staging/

# A4 Speed is licensed for personal use only in its free form. This repository
# is public, so committing the binary would be redistribution — regardless of
# whether the site serves it. It stays out until KUFS holds the commercial
# licence; see the Licensing section of README.md.
# The site falls back to Barlow Condensed Bold Italic when these are absent.
src/assets/fonts/*.ttf
src/assets/fonts/*.otf
src/assets/fonts/*.woff2
public/fonts/*.woff2
public/fonts/*.ttf
