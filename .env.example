# ---------------------------------------------------------------------------
# KUFS website environment
#
# Every variable here is OPTIONAL. The site builds and runs with none of them
# set — you only need them for a real deployment. Copy to `.env.local` for
# local development, and set them in the Vercel dashboard for deploys.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time.
# Never put a secret in one. Nothing on this site needs a server-side secret.
# ---------------------------------------------------------------------------

# Canonical origin, no trailing slash. Drives canonical tags, the sitemap,
# robots.txt and every Open Graph URL. Set this in Vercel's PRODUCTION
# environment only — preview deploys fall back to their own VERCEL_URL so they
# never claim to be production.
NEXT_PUBLIC_SITE_URL=https://kufs-website.vercel.app

# Plausible analytics. Unset => no analytics script is rendered at all, so
# local development and previews stay out of the numbers.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Self-hosted Plausible origin. Leave blank for plausible.io.
NEXT_PUBLIC_PLAUSIBLE_HOST=

# Formspree endpoint for the sponsorship and contact forms.
# Get one free at https://formspree.io — create a form, copy its endpoint.
# Unset => both forms fall back to opening the visitor's mail client, which
# still works but converts worse. Set this before launch.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# ---------------------------------------------------------------------------
# TinaCMS — the /admin content panel
#
# Both of these come from the Tina Cloud dashboard at https://app.tina.io,
# under your project's Overview and Tokens tabs.
#
# UNSET => no admin panel. `/admin` returns 404, and the site builds, deploys
# and serves exactly as it does today with all of its content still editable
# by editing the files in /content directly. Nothing else degrades. That is
# deliberate: a future committee that lets the Tina account lapse must still
# have a working website.
#
# TINA_TOKEN IS A SECRET. It has write access to this repository through Tina
# Cloud. It is NOT prefixed NEXT_PUBLIC_, so it never reaches the browser —
# keep it that way, and set it in Vercel rather than in any committed file.
# ---------------------------------------------------------------------------

# Public. Identifies the Tina Cloud project. Safe in the browser bundle.
NEXT_PUBLIC_TINA_CLIENT_ID=

# SECRET. Read-write token for content. Set in Vercel, never in git.
TINA_TOKEN=

# Which branch saves commit to. Leave blank on Vercel — it falls back to the
# deployment's own branch, so a preview edits the preview branch rather than
# writing straight to production.
NEXT_PUBLIC_TINA_BRANCH=
