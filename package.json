{
  "name": "kufs-website",
  "version": "0.1.0",
  "private": true,
  "description": "Public website for the KUFS Formula Student team.",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-admin.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "render:frames": "node scripts/render-hero-frames.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:hero": "node scripts/check-hero.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "font:subset": "node scripts/subset-display-font.mjs",
    "check:brand": "node scripts/check-brand-rules.mjs",
    "screens": "node scripts/capture-screens.mjs",
    "check:perf": "node scripts/check-perf.mjs",
    "check:scroll": "node scripts/check-scroll.mjs",
    "brand:slice": "node scripts/slice-brand-logos.mjs",
    "check:font-licence": "node scripts/check-font-licence.mjs",
    "check:glyphs": "node scripts/check-glyphs.mjs",
    "dev:cms": "tinacms dev -c \"next dev\"",
    "check:tina": "node scripts/check-tina-schema.mjs"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "next": "16.3.1",
    "next-mdx-remote": "^6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tinacms/cli": "^2.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.7.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "subset-font": "^2.5.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "tinacms": "^3.12.0",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20.11"
  }
}
